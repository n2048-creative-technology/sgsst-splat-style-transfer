+        # Lazy-load mode: don't materialize the full-res image tensor now --
+        # load it from disk on each access instead. Trades speed (re-decodes
+        # JPEG + re-converts every time original_image is read) for RAM: with
+        # hundreds of full-res training images, eagerly holding every decoded
+        # tensor in memory can exceed a worker's memory budget even though
+        # there's plenty of free system RAM overall (confirmed OOM-killer
+        # cgroup kill, 2026-11-10, dense 699-camera scene). Does NOT change
+        # style-transfer quality/resolution -- same pixels, just loaded later.
+        self._lazy_image_path = lazy_image_path
+        self._lazy_resolution = lazy_resolution
+        if lazy_image_path is not None:
+            self._cached_original_image = None
+            self.image_width = lazy_resolution[0]
